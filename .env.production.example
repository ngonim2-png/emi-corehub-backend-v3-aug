# Copy to .env.production and fill in real values. Never commit the
# filled-in file - .env.production is already in .gitignore.

NODE_ENV=production
PORT=3000

DB_USERNAME=emi_app
DB_PASSWORD=CHANGE-ME-to-a-long-random-value
DB_NAME=emi_corehub
# DB_HOST and REDIS_HOST are set by docker-compose.prod.yml itself
# (they point at the "postgres" and "redis" service names) - don't
# set them here, they'll be overridden.
#
# Deploying to a managed platform (Render, Railway, etc.) instead of
# this Docker Compose setup? Skip everything above and set DATABASE_URL
# and REDIS_URL instead - both are supported and take priority over the
# separate host/port/user/pass fields. The platform gives you both
# connection strings directly when you provision its Postgres and Redis
# add-ons.

JWT_ACCESS_SECRET=CHANGE-ME-generate-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=CHANGE-ME-generate-a-different-one
JWT_REFRESH_EXPIRY=7d

SMS_PROVIDER=orange
SMS_API_KEY=
SMS_SENDER_ID=EMI

# Same simulate-until-configured pattern as SMS above - real sending needs
# a real provider (SendGrid, Postmark, SMTP, etc.) wired into
# src/modules/notifications/adapters/smtp-email.adapter.ts.
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@enhancedmutual.sl

# Shared secret an external lead-capture integration (Meta/Facebook Lead
# Ads, a website contact form, etc.) must send as the X-Webhook-Secret
# header when POSTing to /crm/external-leads. Generate with:
#   openssl rand -hex 24
LEAD_WEBHOOK_SECRET=

S3_ENDPOINT=
S3_BUCKET=emi-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

PREMIUM_DUE_DAY=5
WARNING_THRESHOLD_MONTHS=2
LAPSE_THRESHOLD_MONTHS=3

ANTHROPIC_API_KEY=
