# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=emi_app
DB_PASSWORD=changeme
DB_NAME=emi_corehub

# Redis (queues, cache, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRY=7d

# Client portal (separate secret from staff auth above, on purpose -
# keeps a portal token from ever being usable against staff endpoints
# even if it were somehow signed with the wrong secret)
PORTAL_JWT_SECRET=changeme-portal-secret-different-from-the-others

# SMS gateway - Alemobet Limited (real provider)
SMS_PROVIDER=alemobet
SMS_SENDER_ID=EMI
# Alemobet server/port/credentials - get these from Alemobet, then set the
# real values here. Until ALEMOBET_SERVER is set, sends are simulated
# (logged, marked Sent, nothing actually goes out) so nothing breaks with
# these left blank.
ALEMOBET_SERVER=
ALEMOBET_PORT=8080
ALEMOBET_USERNAME=
ALEMOBET_PASSWORD=
# Automatic SMS (payment receipts, claim status updates, lifecycle
# marketing triggers) is off by default - every message it would have
# sent is held as Pending for a person to review and send manually
# instead. Set to true once ready for these to send on their own.
SMS_AUTOMATIC_ENABLED=false
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@enhancedmutual.sl
LEAD_WEBHOOK_SECRET=dev-webhook-secret

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=emi-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Business rules (can be overridden per-tenant in system_settings table later)
PREMIUM_DUE_DAY=5
WARNING_THRESHOLD_MONTHS=2
LAPSE_THRESHOLD_MONTHS=3
