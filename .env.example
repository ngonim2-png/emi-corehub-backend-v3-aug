# Server
PORT=3000
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=emi_app
DB_PASSWORD=changeme
DB_NAME=emi_corehub

# Redis (queues, cache, rate limiting)
REDIS_HOST=localhost
REDIS_PORT=6379

# Auth
JWT_ACCESS_SECRET=changeme-access-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=changeme-refresh-secret
JWT_REFRESH_EXPIRY=7d

# SMS gateway
SMS_PROVIDER=orange
SMS_API_KEY=changeme
SMS_SENDER_ID=EMI
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=noreply@enhancedmutual.sl
LEAD_WEBHOOK_SECRET=dev-webhook-secret

# Object storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=emi-documents
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Business rules (can be overridden per-tenant in system_settings table later)
PREMIUM_DUE_DAY=5
WARNING_THRESHOLD_MONTHS=2
LAPSE_THRESHOLD_MONTHS=3
